# Nginx reverse proxy for Pixl on a single EC2 host.
# Public entry: :80
#   DOMAIN / www.DOMAIN  → Nuxt (frontend:3000)
#   api.DOMAIN           → Express (backend:3001)
#
# TLS can be added later with certbot / a second listen 443 block.

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  client_max_body_size 100m;

  upstream pixl_frontend {
    server frontend:3000;
  }

  upstream pixl_backend {
    server backend:3001;
  }

  # Nuxt web app
  server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location / {
      proxy_pass http://pixl_frontend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
  }

  # Express API
  server {
    listen 80;
    server_name api.${DOMAIN};

    location / {
      proxy_pass http://pixl_backend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 120s;
      proxy_send_timeout 120s;
    }
  }

  # Fallback when DOMAIN is not yet configured (IP access)
  server {
    listen 80 default_server;
    server_name _;

    location /api/ {
      rewrite ^/api/?(.*)$ /$1 break;
      proxy_pass http://pixl_backend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      client_max_body_size 100m;
    }

    location / {
      proxy_pass http://pixl_frontend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
  }
}
