# Pixl API — raise upload limit (nginx default is 1m).
# Without this, browser uploads over ~1MB fail as: Failed to fetch
#
# On the EC2 host, add the line below inside the server { } block for
# api.pixl-personal-project.online (usually under /etc/nginx/sites-available/),
# then reload nginx:
#
#   sudo nginx -t && sudo systemctl reload nginx

client_max_body_size 50M;
client_body_timeout 120s;
proxy_read_timeout 120s;
proxy_send_timeout 120s;
proxy_request_buffering off;
