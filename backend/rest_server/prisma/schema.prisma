datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProfileVisibility {
  PRIVATE
  PUBLIC
  BANNED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                     String               @id @default(auto()) @map("_id") @db.ObjectId
  email                  String               @unique
  isEmailVerified        Boolean
  userName               String               @unique
  name                   String
  password               String
  dateOfBirth            DateTime?
  gender                 String?
  age                    Int
  profilePic             String?
  bio                    String?
  website                String?
  profileVisibility      ProfileVisibility    @default(PRIVATE)
  emailOTP               EmailOTP[]
  subComments            SubComment[]
  posts                  Post[]
  followInitiated        Follow[]             @relation("Initiator")
  followReceived         Follow[]             @relation("Receiver")
  followInitiatedRequest FollowRequest[]      @relation("RequestInitiator")
  followReceivedRequest  FollowRequest[]      @relation("RequestReceiver")
  login                  Login[]
  reels                  Reels[]
  favouriteUsers         FavouriteUsers[]
  notifications          UserNotification[]
  stories                Stories[]
  storiesMentions        StoriesMentions[]
  storiesSeen            StoriesSeen[]
  storiesReactions       StoriesReactions[]
  liveStreams            LiveStream[]
  liveStreamComments     LiveStreamComments[]
  sentMessages           Message[]            @relation("SentMessages")
  receivedMessages       Message[]            @relation("ReceivedMessages")
  groups                 Group[]
  groupMember            GroupMember[]
  PostMentions           PostMentions[]
  ReelMentions           ReelMentions[]
  Reactions              Reaction[]
  Comments               Comment[]
  Shares                 Share[]
  savedPosts             SavedPost[]
  MessageReactions       MessageReaction[]
  MessageSeen            MessageSeen[]
  postsCount             Int                  @default(0)
  fcmToken               String?
  roleKey                String               @default("USER")
  directPermissions      String[]             @default([])
  deniedPermissions      String[]             @default([])
  accountStatus          AccountStatus        @default(ACTIVE)
  suspendedUntil         DateTime?
  sessionVersion         Int                  @default(0)
  livePrivilegesRevoked  Boolean              @default(false)
  commentsLocked         Boolean              @default(false)
  featureRestrictions    Json?
  deletedAt              DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([roleKey])
  @@index([accountStatus])
  @@index([createdAt])
}

model Group {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  groupId        String        @unique
  name           String?
  adminId        String        @db.ObjectId
  admin          User          @relation(fields: [adminId], references: [id])
  displayPicture String?
  members        GroupMember[]
  messages       Message[]
}

enum GroupMemberRole {
  admin
  member
}

model GroupMember {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  user    User             @relation(fields: [userId], references: [id])
  userId  String           @db.ObjectId
  group   Group            @relation(fields: [groupId], references: [id])
  groupId String           @db.ObjectId
  role    GroupMemberRole?
}

model MessageReaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  message   Message  @relation("MessageReaction", fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messageId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  emoji     String?
  emojiCode String?
  createdAt DateTime @default(now())
}

model MessageSeen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  message   Message  @relation("MessageSeen", fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messageId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

model Message {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  message        String
  retracted      Boolean           @default(false)
  receiver       User?             @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId     String?           @db.ObjectId
  sender         User              @relation("SentMessages", fields: [senderId], references: [id])
  senderId       String            @db.ObjectId
  group          Group?            @relation(fields: [groupId], references: [id])
  groupId        String?           @db.ObjectId
  seen           MessageSeen[]     @relation("MessageSeen")
  mediaUrl       String[]
  reactions      MessageReaction[] @relation("MessageReaction")
  // Self-referencing relation: reply-to-message
  replyTo        String?           @db.ObjectId
  replyToMsg     Message?          @relation("ReplyChain", fields: [replyTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Message[]         @relation("ReplyChain")
  conversationId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum LiveStreamStatus {
  CREATED
  STARTING
  LIVE
  ENDING
  ENDED
  FAILED
}

enum LiveVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

model LiveStream {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  userId            String               @db.ObjectId
  user              User                 @relation(fields: [userId], references: [id])
  title             String
  url               String
  viewers           String[]
  comments          LiveStreamComments[]
  status            LiveStreamStatus     @default(CREATED)
  visibility        LiveVisibility       @default(PUBLIC)
  recordingEnabled  Boolean              @default(false)
  javaStreamId      String?
  viewerCount       Int                  @default(0)
  likeCount         Int                  @default(0)
  startedAt         DateTime?
  endedAt           DateTime?
  terminatedById    String?              @db.ObjectId
  terminateReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model LiveStreamComments {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  liveId    String     @db.ObjectId
  live      LiveStream @relation(fields: [liveId], references: [id])
  text      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNFOLLOWED
  BLOCKED
  UNBLOCKED
}

model FollowRequest {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  targetId  String       @db.ObjectId
  user      User         @relation("RequestInitiator", fields: [userId], references: [id])
  target    User         @relation("RequestReceiver", fields: [targetId], references: [id])
  status    FollowStatus @default(PENDING) // "PENDING", "ACCEPTED", "REJECTED"
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([targetId])
}

model Follow {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  targetId  String   @db.ObjectId
  user      User     @relation("Initiator", fields: [userId], references: [id])
  target    User     @relation("Receiver", fields: [targetId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([targetId])
}

model ReelMentions {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId // User who is mentioned
  user      User     @relation(fields: [userId], references: [id])
  reelId    String   @db.ObjectId
  reels     Reels    @relation(fields: [reelId], references: [id], name: "PostToMentions")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostMentions {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId // User who is mentioned
  user      User     @relation(fields: [userId], references: [id])
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], name: "PostToMentions")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  message   String
  type      String // "mention", "comment", "like", "moderation", etc.
  postId    String?  @db.ObjectId // Optional: reference to a post if it's a mention notification
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stories {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  media        Media              @relation(fields: [mediaId], references: [id])
  userId       String             @db.ObjectId
  user         User               @relation(fields: [userId], references: [id])
  mentions     StoriesMentions[]
  seen         StoriesSeen[]
  reactions    StoriesReactions[]
  hidden       Boolean            @default(false)
  hiddenReason String?
  hiddenAt     DateTime?
  hiddenById   String?            @db.ObjectId
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  mediaId      String             @db.ObjectId

  @@index([userId])
  @@index([hidden])
}

model StoriesSeen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  storyId   String   @db.ObjectId
  story     Stories  @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storyId])
}

model StoriesReactions {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  storyId   String   @db.ObjectId
  story     Stories  @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoriesMentions {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  storyId   String   @db.ObjectId
  story     Stories  @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FavouriteUsers {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reels {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  media        Media[]
  caption      String
  tags         String[] // Array of tags
  taggedUsers  String[] // Array of usernames tagged in this reel
  reactions    Reaction[]
  comments     Comment[]
  mentions     ReelMentions[] @relation("PostToMentions")
  userId       String         @db.ObjectId
  user         User           @relation(fields: [userId], references: [id])
  hidden       Boolean        @default(false)
  hiddenReason String?
  hiddenAt     DateTime?
  hiddenById   String?        @db.ObjectId
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([hidden])
}

enum MediaType {
  IMAGE
  VIDEO
}

model Media {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  url         String
  musicCredit String?
  mimeType    MediaType
  thumbnail   String?
  labels      String[]  @default([])
  labelScores Json?
  postId      String?   @db.ObjectId
  post        Post?     @relation(fields: [postId], references: [id])
  reelId      String?   @db.ObjectId
  reel        Reels?    @relation(fields: [reelId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stories     Stories[]
}

enum ReactionType {
  HEART
  EMOJI
  GIF
}

model Reaction {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  type          ReactionType @default(HEART)
  otherTypeCode String?
  userId        String       @db.ObjectId
  user          User         @relation(fields: [userId], references: [id])
  postId        String?      @db.ObjectId
  post          Post?        @relation(fields: [postId], references: [id])
  reelId        String?      @db.ObjectId
  reel          Reels?       @relation(fields: [reelId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, postId])
  @@index([postId]) // ✅ fast fetch post reactions
  @@index([userId])
}

model SubComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  commentId String   @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  text         String
  userId       String       @db.ObjectId
  user         User         @relation(fields: [userId], references: [id])
  postId       String?      @db.ObjectId
  post         Post?        @relation(fields: [postId], references: [id])
  reelId       String?      @db.ObjectId
  reel         Reels?       @relation(fields: [reelId], references: [id])
  subComment   SubComment[]
  hidden       Boolean      @default(false)
  hiddenReason String?
  hiddenAt     DateTime?
  hiddenById   String?      @db.ObjectId
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([postId])
  @@index([reelId])
  @@index([userId])
  @@index([hidden])
}

model Share {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userTag   String   @db.ObjectId
  user      User     @relation(fields: [userTag], references: [id])
  postTag   String   @db.ObjectId
  post      Post     @relation(fields: [postTag], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UICategory {
  IGTV
  SHOP
  STYLE
  SPORTS
  AUTO
  MUSIC
  MOVIES
  UNSET
}

model Post {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  media              Media[]
  taggedUsers        String[] // Array of usernames tagged in this post
  systemTags         String[]
  userTags           String[]
  location           Json?
  caption            String
  reactionsCount     Int?
  comments           Comment[]
  shares             Share[]
  savedBy            SavedPost[]
  uiCategory         UICategory     @default(UNSET)
  userId             String         @db.ObjectId
  user               User           @relation(fields: [userId], references: [id])
  mentions           PostMentions[] @relation("PostToMentions")
  postDisabled       Boolean        @default(false)
  postDisabledReason String?
  postDisabledAt     DateTime?
  postDisabledById   String?        @db.ObjectId
  commentsLocked     Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  reactions          Reaction[]

  @@index([userId])
  @@index([postDisabled])
  @@index([createdAt])
}

model SavedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model Login {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  email                   String
  enteredPassword         String
  isPasswordAuthenticated Boolean
  IPAddress               String
  responseMessage         String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  User                    User?    @relation(fields: [userId], references: [id])
  userId                  String?  @db.ObjectId
}

model EmailOTP {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String
  name            String
  otp             Int
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?
  userID          String    @db.ObjectId
  user            User      @relation(fields: [userID], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  name        String
  description String
  permissions String[]
  rank        Int
  isSystem    Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([archived])
  @@index([rank])
}

model StaffAssignment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  roleKey        String
  assignedById   String?   @db.ObjectId
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  deactivatedAt  DateTime?

  @@index([userId, active])
  @@index([roleKey])
}

model Report {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  reporterId   String    @db.ObjectId
  targetType   String
  targetId     String
  targetUserId String?   @db.ObjectId
  category     String
  severity     String    @default("MEDIUM")
  status       String    @default("NEW")
  reason       String
  details      String?
  evidence     Json?
  assigneeId   String?   @db.ObjectId
  caseId       String?   @db.ObjectId
  resolution   String?
  resolvedById String?   @db.ObjectId
  resolvedAt   DateTime?
  version      Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([category])
  @@index([severity])
}

model ModerationCase {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  source       String
  status       String    @default("NEW")
  priority     String    @default("NORMAL")
  severity     String    @default("MEDIUM")
  category     String
  targetType   String
  targetId     String
  targetUserId String?   @db.ObjectId
  reportId     String?   @db.ObjectId
  assigneeId   String?   @db.ObjectId
  slaDueAt     DateTime?
  version      Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
  @@index([targetType, targetId])
  @@index([targetUserId])
  @@index([reportId])
}

model ModerationAction {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  type           String
  actorId        String    @db.ObjectId
  targetType     String
  targetId       String
  targetUserId   String?   @db.ObjectId
  reason         String?
  severity       String?
  expiresAt      DateTime?
  caseId         String?   @db.ObjectId
  reportId       String?   @db.ObjectId
  previousState  Json?
  resultingState Json?
  createdAt      DateTime  @default(now())

  @@index([targetType, targetId])
  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([caseId])
  @@index([type])
}

model ModerationNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  caseId     String?  @db.ObjectId
  userId     String?  @db.ObjectId
  reportId   String?  @db.ObjectId
  authorId   String   @db.ObjectId
  body       String
  visibility String   @default("INTERNAL")
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([userId])
  @@index([reportId])
}

model ModerationStrike {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  type        String
  reason      String
  severity    String    @default("MEDIUM")
  expiresAt   DateTime?
  actorId     String    @db.ObjectId
  reportId    String?   @db.ObjectId
  contentType String?
  contentId   String?
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([userId, active])
  @@index([expiresAt])
}

model Appeal {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  actionId         String?   @db.ObjectId
  type             String
  status           String    @default("NEW")
  statement        String
  evidence         Json?
  reviewerId       String?   @db.ObjectId
  reviewReason     String?
  originalActorId  String?   @db.ObjectId
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([actionId])
}

model AuditLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId          String?  @db.ObjectId
  actorRole        String?
  action           String
  targetType       String?
  targetId         String?
  reason           String?
  requestId        String?
  ip               String?
  userAgent        String?
  before           Json?
  after            Json?
  caseId           String?  @db.ObjectId
  reportId         String?  @db.ObjectId
  impersonationId  String?  @db.ObjectId
  createdAt        DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  enabled     Boolean  @default(false)
  description String
  updatedById String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  updatedById String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AdminAnnouncement {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  body          String
  audience      String    @default("ALL")
  targetUserIds String[]  @default([])
  createdById   String    @db.ObjectId
  scheduledAt   DateTime?
  sentAt        DateTime?
  status        String    @default("SENT")
  createdAt     DateTime  @default(now())

  @@index([createdAt])
}

model ImpersonationSession {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  actorId   String    @db.ObjectId
  targetId  String    @db.ObjectId
  active    Boolean   @default(true)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([actorId, active])
  @@index([targetId])
}
