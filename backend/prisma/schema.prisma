model Media {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  url         String
  musicCredit String?
  userTag     String   @db.ObjectId
  user        User     @relation(fields: [userTag], references: [id])
  postId      String   @db.ObjectId
  post        Post     @relation(fields: [postId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  userTag   String   @db.ObjectId
  user      User     @relation(fields: [userTag], references: [id])
  postTag   String?  @db.ObjectId
  post      Post?    @relation(fields: [postTag], references: [id])
  reelTag   String?  @db.ObjectId
  reel      Reels?   @relation(fields: [reelTag], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  commentId String   @db.ObjectId
  comment   Comment  @relation(fields: [commentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  text       String
  userId     String       @db.ObjectId
  user       User         @relation(fields: [userId], references: [id])
  postId     String?      @db.ObjectId
  post       Post?        @relation(fields: [postId], references: [id])
  reelId     String?      @db.ObjectId
  reel       Reels?       @relation(fields: [reelId], references: [id])
  subComment SubComment[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Share {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userTag   String   @db.ObjectId
  user      User     @relation(fields: [userTag], references: [id])
  postTag   String   @db.ObjectId
  post      Post     @relation(fields: [postTag], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  media              Media[]
  tagId              String          @db.ObjectId
  tag                Tag             @relation(fields: [tagId], references: [id])
  location           String?
  caption            String
  reactions          Reaction[]
  comments           Comment[]
  shares             Share[]
  userId             String          @db.ObjectId
  user               User            @relation(fields: [userId], references: [id])
  // postCollectionId   String?         @db.ObjectId
  // postCollection     PostCollection? @relation(fields: [postCollectionId], references: [id])
  postDisabled       Boolean         @default(false)
  postDisabledReason String?
  postDisabledAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Login {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  email                   String
  enteredPassword         String
  isPasswordAuthenticated Boolean
  IPAddress               String
  responseMessage         String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  User                    User?    @relation(fields: [userId], references: [id])
  userId                  String?  @db.ObjectId
}

model EmailOTP {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String
  name            String
  otp             Int
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?
  userID          String    @db.ObjectId
  user            User      @relation(fields: [userID], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
