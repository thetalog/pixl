datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String               @id @default(auto()) @map("_id") @db.ObjectId
  email                  String               @unique
  isEmailVerified        Boolean
  userName               String               @unique
  name                   String
  password               String
  age                    Int
  latestJWT              String?
  profilePic             String?
  bio                    String?
  website                String?
  profileVisibility      String               @default("private")
  emailOTP               EmailOTP[]
  taggedPosts            Media[]
  postReactions          Reaction[]
  postComments           Comment[]
  subComments            SubComment[]
  postShare              Share[]
  posts                  Post[]
  // postCollections        PostCollection[]
  followInitiated        Follow[]             @relation("Initiator")
  followReceived         Follow[]             @relation("Receiver")
  followInitiatedRequest FollowRequest[]      @relation("RequestInitiator")
  followReceivedRequest  FollowRequest[]      @relation("RequestReceiver")
  login                  Login[]
  reels                  Reels[]
  favouriteUsers         FavouriteUsers[]
  notifications          UserNotification[]
  stories                Stories[]
  storiesMentions        StoriesMentions[]
  storiesSeen            StoriesSeen[]
  storiesReactions       StoriesReactions[]
  liveStreams            LiveStream[]
  liveStreamComments     LiveStreamComments[]
  messages               Message[]
  groups                 GroupMember[]
  updatedAt              DateTime             @updatedAt
  createdAt              DateTime             @default(now())
}

model Group {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  name     String?
  type     String
  members  GroupMember[]
  messages Message[]
}

model GroupMember {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  user    User   @relation(fields: [userId], references: [id])
  userId  String @db.ObjectId
  group   Group  @relation(fields: [groupId], references: [id])
  groupId String @db.ObjectId
  // role    String
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  timestamp DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  String   @db.ObjectId
  group     Group    @relation(fields: [groupId], references: [id])
  groupId   String   @db.ObjectId
}

model LiveStream {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  userId    String               @db.ObjectId
  user      User                 @relation(fields: [userId], references: [id])
  title     String
  url       String
  viewers   String[]
  comments  LiveStreamComments[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model LiveStreamComments {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  liveId    String     @db.ObjectId
  live      LiveStream @relation(fields: [liveId], references: [id])
  text      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model FollowRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  targetId  String   @db.ObjectId
  user      User     @relation("RequestInitiator", fields: [userId], references: [id])
  target    User     @relation("RequestReceiver", fields: [targetId], references: [id])
  status    String   @default("pending") // "pending", "accepted", "declined"
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetId])
}

model Follow {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  targetId  String   @db.ObjectId
  user      User     @relation("Initiator", fields: [userId], references: [id])
  target    User     @relation("Receiver", fields: [targetId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetId])
}

model Tag {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  posts Post[]
  reels Reels[]
}

model UserNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stories {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  userId    String             @db.ObjectId
  user      User               @relation(fields: [userId], references: [id])
  mentions  StoriesMentions[]
  seen      StoriesSeen[]
  reactions StoriesReactions[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model StoriesSeen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  storyId   String   @db.ObjectId
  story     Stories  @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoriesReactions {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  storyId   String   @db.ObjectId
  story     Stories  @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoriesMentions {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  storyId   String   @db.ObjectId
  story     Stories  @relation(fields: [storyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FavouriteUsers {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reels {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  url              String
  musicCredit      String?
  caption          String
  tagId            String          @db.ObjectId
  tag              Tag             @relation(fields: [tagId], references: [id])
  reactions        Reaction[]
  comments         Comment[]
  userId           String          @db.ObjectId
  user             User            @relation(fields: [userId], references: [id])
  // postCollectionId String?         @db.ObjectId
  // postCollection   PostCollection? @relation(fields: [postCollectionId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

