# =============================================================================
# Pixl — production environment for Docker Compose on a single EC2 instance
# Copy:  cp .env.example .env
# Then replace EVERY placeholder before: docker compose up -d --build
# =============================================================================

# --- Public host / routing ---------------------------------------------------
# Used by Nginx server_name. Point DNS A records:
#   DOMAIN        → EC2 public IP   (Nuxt)
#   api.DOMAIN    → EC2 public IP   (API)
DOMAIN=project1.com

# Host port for Nginx (default 80)
HTTP_PORT=80

# Browser-facing API base URL (baked + runtime for Nuxt)
# With domains:     https://api.project1.com
# With IP-only:     http://YOUR_EC2_IP/api
API_BASE=https://api.project1.com

# Public site URL (share links, CORS origin fallback)
FRONTEND_URL=https://project1.com

# Live websocket (separate livestream service; optional for now)
LIVE_WS_BASE=ws://localhost:9090

# --- MongoDB (single-node replica set) ---------------------------------------
# IMPORTANT: one Mongo container on one EC2 ≠ high availability.
REPLICA_SET_NAME=rs0
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MONGO_APP_USERNAME=pixl
MONGO_APP_PASSWORD=CHANGE_ME_strong_app_password
MONGO_APP_DB=pixl

# Must match mongo-init users / replica set name / service hostname "mongo"
# URL-encode special characters in passwords.
DATABASE_URL=mongodb://pixl:CHANGE_ME_strong_app_password@mongo:27017/pixl?authSource=admin&replicaSet=rs0&directConnection=true

# --- Auth --------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_long_random_jwt_secret

# --- Email OTP (SMTP) --------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_PASSWORD=CHANGE_ME_smtp_app_password

# --- MinIO (S3-compatible object storage) ------------------------------------
# Backend talks to service name "minio" on the Docker network.
# Root credentials are also used as MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
MINIO_ROOT_USER=pixlminio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password

MINIO_POSTS_BUCKET=pixl
MINIO_CONVERSATION_DIRECT_MESSAGE_BUCKET=conversation-direct-messages
MINIO_CONVERSATION_GROUP_MESSAGE_BUCKET=conversation-group-messages
MINIO_CONVERSATION_GROUP_DP_BUCKET=conversation-group-dp
MINIO_PROFILE_BUCKET=pixl-profile

# --- Firebase Cloud Messaging (optional but needed for push) -----------------
FIREBASE_PROJECT_ID=
# Entire service-account JSON as a single line string, e.g.:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT=
