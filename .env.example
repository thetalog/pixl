# =============================================================================
# Pixl — production environment (Docker Compose on EC2)
# Copy:  cp .env.example .env
# Replace every CHANGE_ME value before: docker compose up -d --build
# =============================================================================

# --- Public routing ----------------------------------------------------------
DOMAIN=project1.com
HTTP_PORT=80

# Browser-facing API base (Nuxt). With domains: https://api.project1.com
# IP-only fallback: http://YOUR_EC2_IP/api
API_BASE=https://api.project1.com
FRONTEND_URL=https://project1.com

# Optional livestream websocket (separate service)
LIVE_WS_BASE=ws://localhost:9090

# --- MongoDB (single-node replica set for Prisma $transaction) ---------------
REPLICA_SET_NAME=rs0
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MONGO_APP_USERNAME=pixl
MONGO_APP_PASSWORD=CHANGE_ME_strong_app_password
MONGO_APP_DB=pixl

# Password must match MONGO_APP_PASSWORD (URL-encode special characters)
DATABASE_URL=mongodb://pixl:CHANGE_ME_strong_app_password@mongo:27017/pixl?authSource=admin&replicaSet=rs0&directConnection=true

# --- Auth --------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_long_random_jwt_secret

# --- Email OTP (SMTP) --------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@example.com
EMAIL_PASSWORD=CHANGE_ME_smtp_app_password

# --- AWS S3 (media storage) --------------------------------------------------
AWS_ACCESS_KEY_ID=CHANGE_ME_aws_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_aws_secret_key
AWS_REGION=ap-south-1

# Optional CDN / custom base. Leave empty to use default:
#   https://<bucket>.s3.<region>.amazonaws.com/<key>
S3_PUBLIC_BASE_URL=

# Create these buckets in AWS (or allow the app IAM role to create them)
S3_BUCKET_POSTS=pixl-posts
S3_BUCKET_DM=pixl-dm
S3_BUCKET_GROUP_MSG=pixl-group-msg
S3_BUCKET_GROUP_DP=pixl-group-dp
S3_BUCKET_PROFILE=pixl-profile

# --- Firebase Cloud Messaging (optional) -------------------------------------
FIREBASE_PROJECT_ID=
# Full service-account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT=
