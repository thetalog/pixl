# External Pixl API (backend/rest_server)
# Example: EC2 public IP + API port
NUXT_PUBLIC_API_HOST=127.0.0.1
NUXT_PUBLIC_API_PORT=3001

# Optional override — if set, host/port above are ignored
# NUXT_PUBLIC_API_BASE=http://12.34.56.78:3001

# Optional livestream websocket
NUXT_PUBLIC_LIVE_WS_BASE=ws://127.0.0.1:9090
