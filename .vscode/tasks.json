{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pixl Dev Stack",
      "dependsOn": [
        "1_Mongo",
        "2_MinIO",
        "3_REST Nodemon",
        "4_Kurento",
        "5_Livestream",
        "6_Flutter"
      ]
    },
    {
      "label": "1_Mongo",
      "type": "shell",
      "command": "cd backend/rest_server && ./startup.sh",
      "presentation": { "panel": "new" }
    },
    {
      "label": "2_MinIO",
      "type": "shell",
      "command": "cd backend/rest_server && ./minio_startup.sh",
      "presentation": { "panel": "new" }
    },
    {
      "label": "3_REST Nodemon",
      "type": "shell",
      "command": "cd backend/rest_server && nodemon .",
      "presentation": { "panel": "new" }
    },
    {
      "label": "4_Kurento",
      "type": "shell",
      "command": "docker run --rm -p 8890:8888/tcp -p 5000-5050:5000-5050/udp -e KMS_MIN_PORT=5000 -e KMS_MAX_PORT=5050 kurento/kurento-media-server:7.3.0",
      "presentation": { "panel": "new" }
    },
    {
      "label": "5_Livestream",
      "type": "shell",
      "command": "cd backend/livestream_server && gradle run",
      "presentation": { "panel": "new" }
    },
    {
      "label": "6_Flutter",
      "type": "shell",
      "command": "cd frontend/android && flutter run",
      "presentation": { "panel": "new" }
    }
  ]
}
