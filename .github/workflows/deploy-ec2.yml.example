# Optional: deploy to EC2 after push to main.
# Copy to deploy-ec2.yml and fill secrets when ready.
# Required GitHub secrets: EC2_HOST, EC2_USER, EC2_SSH_KEY, EC2_APP_DIR

name: Deploy Pixl to EC2

on:
  workflow_dispatch:
  # push:
  #   branches: [main]

concurrency:
  group: deploy-ec2
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy over SSH
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.EC2_HOST }}
          username: ${{ secrets.EC2_USER }}
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            set -euo pipefail
            cd "${{ secrets.EC2_APP_DIR }}"
            git fetch origin main
            git reset --hard origin/main
            docker compose up -d --build
            docker compose exec -T backend npx prisma db push
            docker compose ps
